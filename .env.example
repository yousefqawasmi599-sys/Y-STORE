# Supabase is optional until a project has been created; empty values keep local demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional legacy/custom API URL. Leave empty to use Supabase or the local demo.
NEXT_PUBLIC_API_URL=

# Public canonical origin for metadata, sitemap and robots (no trailing slash required).
SITE_URL=http://localhost:3000
